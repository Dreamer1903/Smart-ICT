# ---------- School OS backend ----------
APP_NAME="School OS"
ENVIRONMENT=dev

# Локально — SQLite (файл создаётся в папке backend/).
DATABASE_URL=sqlite+aiosqlite:///./school_os.db
# Продакшн — PostgreSQL 16:
# DATABASE_URL=postgresql+asyncpg://school_os:school_os@localhost:5432/school_os

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Ключ, которым физические турникеты подписывают вебхук (заголовок X-Gate-Api-Key)
GATE_API_KEY=dev-gate-key

# CORS для фронтенда (через запятую)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Фоновые задачи (APScheduler внутри процесса API)
SCHEDULER_ENABLED=true
DISCREPANCY_CHECK_INTERVAL_SECONDS=60
# Сколько минут после прохода IN ученик может «идти до класса», прежде чем получит флаг DISCREPANCY
DISCREPANCY_GRACE_MINUTES=10
# Часовой пояс школы — для ежедневного сброса статусов
SCHOOL_TIMEZONE=Asia/Tashkent
DAILY_RESET_HOUR=4

# ---------- Контроль доступа
ACCESS_ALWAYS_ALLOW_EXIT=true
REOPEN_AFTER_PAYMENT_WINDOW_MINUTES=5

# ---------- 1С (HTTP-сервис). Для локальной разработки — симулятор: uvicorn simulators.app:app --port 8010
ONEC_BASE_URL=http://localhost:8010/1c
ONEC_USERNAME=
ONEC_PASSWORD=
ONEC_TIMEOUT_SECONDS=1.5
ONEC_WEBHOOK_SECRET=dev-1c-secret
PAYMENT_CACHE_TTL_SECONDS=300
PAYMENT_DEBT_THRESHOLD=0
# cache — по последнему известному статусу, иначе пропустить; allow — пропускать; deny — не пускать
PAYMENT_UNAVAILABLE_POLICY=cache
PAYMENT_RECHECK_INTERVAL_SECONDS=300


# ---------- Уведомления родителям
NOTIFY_CHANNELS=log
NOTIFY_TELEGRAM_EVENTS=entry,exit,deny,payment,absence,late,homework
NOTIFY_SMS_EVENTS=deny,payment,absence
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# ---------- Протоколы контроллеров
OUTBOX_POLL_SECONDS=5
TCP_LISTENER_ENABLED=false
TCP_LISTENER_PORT=9100

# ---------- HikCentral Professional 3.0 (OpenAPI). AK/SK — секреты, только в .env на сервере.
HIK_ENABLED=false
HIK_BASE_URL=https://127.0.0.1
HIK_APP_KEY=
HIK_APP_SECRET=
HIK_VERIFY_TLS=false
# false — режим наблюдения: SchoolOS показывает, кого закрыл/открыл бы, но права в HikCentral не меняет
HIK_ENFORCE=false
# ID уровней доступа (privilegeGroupId) в HikCentral
HIK_FULL_ACCESS_GROUP_ID=
HIK_EXIT_ONLY_GROUP_ID=
HIK_MATCH_BY=personCode
HIK_EVENT_MODE=poll
HIK_POLL_SECONDS=10
HIK_WEBHOOK_TOKEN=change-me
# Коды событий «пропуск» / «отказ» — заполнить по журналу (GET /integrations/hikcentral/status → seen_event_types)
HIK_GRANTED_EVENT_TYPES=
HIK_DENIED_EVENT_TYPES=

# ---------- Учёт посещаемости
# Пришёл позже — «опоздал» в отчёте
SCHOOL_START_TIME=08:30
