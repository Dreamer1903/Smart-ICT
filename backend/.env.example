# ---------- School OS backend ----------
APP_NAME="School OS"
ENVIRONMENT=dev

# Локально — SQLite (файл создаётся в папке backend/).
DATABASE_URL=sqlite+aiosqlite:///./school_os.db
# Продакшн — PostgreSQL 16:
# DATABASE_URL=postgresql+asyncpg://school_os:school_os@localhost:5432/school_os

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Ключ, которым физические турникеты подписывают вебхук (заголовок X-Gate-Api-Key)
GATE_API_KEY=dev-gate-key

# CORS для фронтенда (через запятую)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Фоновые задачи (APScheduler внутри процесса API)
SCHEDULER_ENABLED=true
DISCREPANCY_CHECK_INTERVAL_SECONDS=60
# Сколько минут после прохода IN ученик может «идти до класса», прежде чем получит флаг DISCREPANCY
DISCREPANCY_GRACE_MINUTES=10
# Часовой пояс школы — для ежедневного сброса статусов
SCHOOL_TIMEZONE=Asia/Tashkent
DAILY_RESET_HOUR=4
